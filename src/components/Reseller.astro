---
import { siteConfig } from '../data/site';
---

<section id="revende" class="scroll-mt-32 py-24 md:py-32 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <span class="text-[#9A4444] uppercase tracking-[0.28em] font-bold text-[0.82rem] leading-none mb-6 block">Revende Anthie</span>
    <h2 class="text-3xl md:text-5xl font-serif text-[#2E2D2A] mb-6">Sumá Anthie a tu comercio.</h2>
    <p class="text-[#5F5A52] text-lg md:text-xl font-light leading-relaxed max-w-3xl mx-auto mb-10">
      Si tenés una farmacia, dietética, un comercio o sos profesional y querés vender Anthie, escribinos para conocer nuestra propuesta.
    </p>
    <a
      href={siteConfig.resellerWhatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-[#9A4444] text-[#FAF8F4] px-8 py-4 rounded-full font-sans font-medium tracking-wide hover:bg-[#843838] transition-colors duration-300"
    >
      Consultar por reventa
    </a>
  </div>
</section>
