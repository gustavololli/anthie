---
import { faqs } from '../data/faqs';
import { productLines } from '../data/product-lines';
---

<section id="aprende" class="scroll-mt-32 py-24 bg-[#FAF8F4]">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-[#9A4444] uppercase tracking-[0.28em] font-bold text-[0.82rem] leading-none mb-6 block">Aprendé</span>
      <h2 class="text-3xl md:text-4xl font-serif text-[#2E2D2A] mb-5">Naturaleza y ciencia, para conocer mejor tu bienestar.</h2>
      <p class="text-[#5F5A52] font-light text-lg leading-relaxed">Conocé nuestras líneas y encontrá respuestas sobre cómo empezar a integrarlas a tu rutina.</p>
    </div>

    <nav aria-label="Conocé nuestras líneas" class="flex flex-wrap justify-center gap-3 mb-16">
      {productLines.map((line) => (
        <a href={`#${line.id}`} class="px-4 py-2 rounded-full border border-[#E8DFCA] text-sm text-[#404728] hover:border-[#9A4444] hover:text-[#9A4444] transition-colors">{line.title}</a>
      ))}
    </nav>

    <h3 class="text-center text-2xl md:text-3xl font-serif text-[#2E2D2A] mb-8">Preguntas frecuentes</h3>

    <div class="space-y-6">
      {faqs.map((faq) => (
        <details class="group bg-[#FAF8F4] rounded-xl border border-[#E8DFCA] hover:border-[rgba(154,68,68,0.35)] open:border-[rgba(154,68,68,0.35)] transition-colors duration-300">
          <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 text-[#2E2D2A] group-hover:text-[#9A4444] group-open:text-[#9A4444] transition-colors">
            <span class="text-lg">{faq.question}</span>
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="text-[#5F5A52] font-light px-6 pb-6 animate-fadeIn">
            <p leading-relaxed>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>


<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
