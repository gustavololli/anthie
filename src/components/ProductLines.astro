---
import { productLines } from '../data/product-lines';
---

<section id="lineas" class="scroll-mt-32 py-24 bg-[#FAF8F4]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-[#9A4444] uppercase tracking-[0.28em] font-bold text-[0.82rem] leading-none mb-6 block">Nuestras líneas</span>
      <h2 class="text-3xl md:text-4xl font-serif text-[#2E2D2A]">Fórmulas para tu equilibrio</h2>
    </div>

    <div class="space-y-6">
      {productLines.map((line) => (
        <article id={line.id} class="scroll-mt-32 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 bg-white p-7 md:p-10 rounded-2xl border border-[#E8DFCA] hover:border-[#9A4444] transition-colors duration-300">
          <div>
            <div class="w-[32px] h-[1px] bg-[#9A4444] mb-6"></div>
            <h3 class="text-2xl md:text-3xl font-serif text-[#2E2D2A] mb-3">{line.title}</h3>
            <p class="font-serif italic text-lg text-[#9A4444] mb-4">{line.tagline}</p>
            <p class="text-[#5F5A52] font-light text-[15px] leading-loose">{line.description}</p>
          </div>
          <div class="border-t md:border-t-0 md:border-l border-[#E8DFCA] pt-6 md:pt-0 md:pl-10">
            <h4 class="text-xs uppercase tracking-[0.2em] font-semibold text-[#404728] mb-4">Productos</h4>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm text-[#5F5A52]">
              {line.products.map((product) => (
                <li class="flex gap-3 leading-relaxed"><span class="text-[#9A4444]" aria-hidden="true">·</span><span>{product}</span></li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
